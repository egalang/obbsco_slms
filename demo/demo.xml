  <data noupdate="1">

    <record id="process_design_review" model="ship.process">
      <field name="name">Ship Design Review</field>
      <field name="description">
        Prepared by Ship Owner, reviewed by Class Society, and approved by MARINA. Includes
        submission of design documents such as general arrangement plans, structural plans,
        hydrostatic curves, and stability calculations.
      </field>
    </record>

    <record id="process_equipment_verification" model="ship.process">
      <field name="name">Equipment and Material Verification</field>
      <field name="description">
        Involves verification of machinery, electrical systems, safety equipment, and material
        specifications. Reviewed by Class Society and approved by MARINA.
      </field>
    </record>

    <record id="process_ship_monitoring" model="ship.process">
      <field name="name">Shipbuilding and/or Ship Repair Monitoring</field>
      <field name="description">
        Covers inspection of shipyard activities, construction and repair documentation, project
        schedules, and shipyard certifications. Supervised by Class Society and approved by MARINA.
      </field>
    </record>

    <record id="process_class_assignment" model="ship.process">
      <field name="name">Assignment and/or Renewal of Class</field>
      <field name="description">
        Classification by Class Society including surveys, class records, damage reports, and
        approved plans. Required for MARINA certificate issuance and vessel operation.
      </field>
    </record>

    <record id="process_certificate_issuance" model="ship.process">
      <field name="name">Certificate Issuance</field>
      <field name="description">
        MARINA issues official vessel certificates including registry, ownership, safety, and
        tonnage documents after review and endorsement by Class Society.
      </field>
    </record>

    <record id="process_maintenance" model="ship.process">
      <field name="name">Maintenance, Inspection, and/or Surveys</field>
      <field name="description">
        Continuous monitoring of machinery, safety, and environmental compliance. Includes class
        surveys, PCG and PPA inspections, oil record books, and planned maintenance system logs.
      </field>
    </record>

    <record id="process_recycling" model="ship.process">
      <field name="name">Ship Recycling Compliance</field>
      <field name="description">
        Documentation for end-of-life recycling including Inventory of Hazardous Materials, Green
        Passport, HazMat surveys, and Ship Recycling Plans. Complies with MARINA and international
        standards.
      </field>
    </record>

  </data>

  <data noupdate="1">

    <record id="status_pending" model="ship.process.status">
      <field name="name">Pending</field>
      <field name="description">Process is defined but not yet started.</field>
      <field name="sequence">10</field>
    </record>

    <record id="status_in_progress" model="ship.process.status">
      <field name="name">In Progress</field>
      <field name="description">Process is currently being worked on or reviewed.</field>
      <field name="sequence">20</field>
    </record>

    <record id="status_reviewed" model="ship.process.status">
      <field name="name">Reviewed</field>
      <field name="description">Process has been reviewed by Class Society or relevant agency.</field>
      <field name="sequence">30</field>
    </record>

    <record id="status_approved" model="ship.process.status">
      <field name="name">Approved</field>
      <field name="description">Process has received final approval (e.g., by MARINA).</field>
      <field name="sequence">40</field>
    </record>

    <record id="status_rejected" model="ship.process.status">
      <field name="name">Rejected</field>
      <field name="description">Process was reviewed but not approved and requires revision.</field>
      <field name="sequence">50</field>
    </record>

    <record id="status_completed" model="ship.process.status">
      <field name="name">Completed</field>
      <field name="description">All steps in the process are finished and no further action is
        required.</field>
      <field name="sequence">60</field>
    </record>

  </data>
